(*
    GVL:      GVL_Modbus
    Project:  Temperature Cabinet Setpoint Control from CODESYS HMI
    Author:   OJ (Omkar Joshi) - Oliver Mechatronics
    Purpose:  Channel-mapped raw variables that the CODESYS Modbus Serial
              Master channels wire onto (I/O Mapping tab). The device-tree
              Modbus configuration does the actual RTU transactions on
              /dev/ttyUSB0; this GVL is the clean boundary between the
              driver and the application logic.
              Matches the Project Development Package spec and the build
              guide already in codesys-modbus-integration/README.md
              (Part 3C, Part 4).

    ------------------------------------------------------------------
    F4S link parameters (confirmed on site and via bench-test - see
    README ADR-001 and the Retest/Requalify phase log):
        Port      : /dev/ttyUSB0  (USB-to-RS232 adapter, no EtherCAT path)
        Baud      : 19200         (F4 "Choose Baud Rate" menu -> 19200)
        Data/Par  : 8 data, No parity, 1 stop (8N1)
        Slave addr: 1             (F4 "Enter Address" menu -> 1)
        Framing   : Modbus RTU
    ------------------------------------------------------------------
    Channel configuration in the device tree (Modbus_COM -> Modbus_Master,
    COM Port -> Modbus_Slave, COM Port, address 1):

      ReadChamberTemp   FC03  offset 100 (fallback 99)   qty 1  Cyclic
                 -> map Holding registers[0] to wInput1Value
      (read-back of the setpoint register is polled the same way at
       offset 300 (fallback 299) -> wSetpoint1Read)
      WriteSetpoint     FC06  offset 300                 qty 1  RISING_EDGE
                 -> map trigger to xWriteTrigger
                 -> map data    to wSetpoint1Write

    Values carry one implied decimal place: raw 1300 == 130.0 degC.
    Register 300 is edge-triggered only (never cyclic) so a write only
    fires when the operator actually changes the setpoint.
*)
{attribute 'qualified_only'}
VAR_GLOBAL
    // FC03 cyclic read, offset 100, length 1 → actual temp raw (x10)
     wReadTempValue    : WORD;
    // FC03 read-back, offset 300, length 1 → SP1 raw read (x10)
    wSetpoint1Read  : WORD;
    // FC06 write single register, offset 300 → SP1 raw write (x10)
    wSetpoint1Write : WORD;
    // Rising-edge trigger for FC06 channel
    xWriteTrigger   : BOOL;
    // Diagnostic status
    xModbusError    : BOOL;
    xModbusDone     : BOOL;
END_VAR
