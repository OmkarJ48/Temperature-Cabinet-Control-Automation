(*
    DUT:      E_SetpointState
    Project:  Temperature Cabinet Setpoint Control from CODESYS HMI
    Author:   OJ (Omkar Joshi) - Oliver Mechatronics
    Purpose:  Sequencer states for FB_CabinetSetpointControl.
              Drives the write -> confirm -> latch flow of a single
              supervisory setpoint change to the Watlow F4S over Modbus.
              Matches the Project Development Package spec and the build
              guide already in codesys-modbus-integration/README.md
              (Part 3A) and the T1-T9 test plan in the main README.

    IEC 61131-3 Structured Text (CODESYS 3.5). Paste into a new DUT
    of type Enumeration named E_SetpointState.
*)
TYPE E_SetpointState :
(
    IDLE        := 0,   (* No request pending; setpoint confirmed/steady      *)
    READY       := 10,  (* Validated request staged, ready to write           *)
    WRITING     := 20,  (* FC06 edge-write issued, waiting for channel done   *)
    CONFIRM     := 30,  (* Comparing FC03 read-back against target            *)
    FAULTED     := 99   (* Latched fault; requires reset                     *)
) INT;
END_TYPE
