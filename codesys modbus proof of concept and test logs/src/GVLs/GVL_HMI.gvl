(*
    GVL:      GVL_HMI
    Project:  Temperature Cabinet Setpoint Control from CODESYS HMI
    Author:   OJ (Omkar Joshi) - Oliver Mechatronics
    Purpose:  Every tag the WebVisu screen binds to. Keeping the HMI
              interface in one GVL makes the Visualization wiring obvious
              and keeps the control logic (FB_CabinetSetpointControl) free
              of screen concerns.
              Matches the Project Development Package spec (WebVisu design
              spec, section B) already reflected in this repo's READMEs.

    WebVisu layout (design guidance handed to the Visualization editor):
      - Oliver Mechatronics logo, top of screen.
      - Gear button labelled "Set the cabinet temperature setpoint".
        The gear opens a pop-up dialog (dlgSetpoint) that binds:
            rReqSetpoint   -> numeric entry (degC), Min 30.0 / Max 130.0
            xSetBtn        -> "SET" momentary button
            xResetBtn      -> "RESET" momentary button
      - Chamber Temperature tile   -> rChamberTemp (read-back, live)
      - Confirmed setpoint tile     -> rConfirmedSetpoint
      - Status banner               -> sStatusText, colour driven by
                                        xFaultActive / xSetpointConfirmed
*)
{attribute 'qualified_only'}
VAR_GLOBAL
    (* ---- Displayed feedback (logic -> WebVisu) ---- *)
    rChamberTemp        : REAL;           (* actual temp, deg C (read/10)    *)
    rConfirmedSetpoint  : REAL;           (* last confirmed SP, deg C        *)

    (* ---- Operator inputs (WebVisu -> logic) ---- *)
    rReqSetpoint        : REAL := 75.0;   (* operator entry (dialog), degC   *)
    xSetBtn              : BOOL;           (* dialog SET button               *)
    xResetBtn            : BOOL;           (* dialog/banner RESET button      *)

    (* ---- Status feedback (logic -> WebVisu) ---- *)
    xSetpointConfirmed   : BOOL;           (* green banner driver             *)
    xFaultActive         : BOOL;           (* red banner driver               *)
    eFaultCode            : E_FaultCode;
    sStatusText           : STRING(80);

    (* ---- Cabinet on/off (logic -> hardware -> WebVisu feedback) ----
       README cabinet on-off automation investigation and test logs §19 (as-built, 6 Aug 2026, supersedes §17 for
       on/off): EL2869 CH15/CH16 now drive two digital inputs on the Omron CPM1A PLC
       that already sits behind the button station and owns the actual start/stop
       latching -- CH15 -> wire 102 -> Omron 0CH.00 (start), CH16 -> wire 103 ->
       Omron 0CH.01 (stop), EL2869 DO GND bonded to Omron COM0. The Omron's own
       ladder program does the start-stop-hold latching; CODESYS only presents a
       level on each input and holds it -- no pulse shaping or timing needed on this
       side, the PLC decides what to do with the level (§19.3).

       xRampInhibit/xRampActive/xPanelLock(Cmd) below are the OLDER §17/§18 F4
       digital-input design (ramp gate + panel lock). They are declared here but
       NOT currently wired -- CH15/CH16 are now committed to the Omron on/off pair
       above, so §17/§18 need reallocation to spare EL2869 channels before they
       are live again. See README §19.5. *)
    xSchedEnable         : BOOL;           (* scheduler enabled flag          *)
    dtSchedStart         : DT;             (* scheduled start date/time (local, wall-clock) *)

    (* The Pi's hardware RTC is kept in UTC (Linux standard practice, confirmed
       via timedatectl: "RTC in local TZ: no"). SysTimeRtcHighResGet reads that
       UTC clock directly with no DST conversion, so dtNow would sit 0-1h behind
       the local wall clock the operator reads dtSchedStart against. This offset
       corrects it. UK has no automatic DST library call available here, so this
       must be toggled by hand twice a year:
         3600 = BST (British Summer Time, late Mar - late Oct)
         0    = GMT (winter, late Oct - late Mar) *)
    diUtcOffsetSec       : DINT := 3600;

    xCabinetOnCmd        : BOOL;           (* desired state, derived from schedule. NOT currently
                                               wired into xStartPulse/xStopPermit below -- open
                                               question, README §19 -- kept computed so the
                                               scheduler is ready to be connected once decided. *)

    (* --- §19 as-built: direct commands to the Omron CPM1A start/stop inputs ---
       Plain, independently-commanded levels -- no timer, no derived pulse, no
       anti-short-cycle lockout. Set from the watch window (or, later, WebVisu) and
       held until changed; the Omron's own ladder logic is the thing that actually
       latches start/stop, so CODESYS does not need to shape a pulse width. *)
    xStartPulse          : BOOL;           (* -> EL2869 CH15 -> wire 102 -> Omron 0CH.00 (start) *)
    xStopPermit          : BOOL;           (* -> EL2869 CH16 -> wire 103 -> Omron 0CH.01 (stop) *)
    xCabinetRunning       : BOOL;           (* commanded-state proxy for WebVisu -- no independent
                                               run feedback wired back from the Omron yet, see
                                               README §19.6 *)

    (* --- §17/§18 F4 digital-input design (ramp gate + panel lock) --- NOT WIRED,
       pending channel reallocation, README §19.5. Declarations kept so the design
       and its CODESYS side are ready to reconnect without rewriting this GVL. *)
    xRampInhibit         : BOOL;           (* -> spare EL2869 channel -> F4 terminal 28 (D/I 1, "Control Outputs Off") *)
    xRampActive          : BOOL;           (* feedback: inverted from xRampInhibit *)
    xPanelLockCmd        : BOOL := TRUE;   (* operator intent: TRUE = keypad locked (default) *)
    xPanelLock           : BOOL;           (* -> spare EL2869 channel -> F4 terminal 29 (D/I 2, "Panel Lock") *)
END_VAR
