(*
    GVL:      GVL_Modbus
    Project:  Temperature Cabinet Setpoint Control from CODESYS HMI
    Author:   OJ (Omkar Joshi) - Oliver Mechatronics
    Purpose:  Channel-mapped raw variables that the CODESYS Modbus TCP
              Master channels wire onto (I/O Mapping tab). The device-tree
              Modbus TCP Master configuration communicates with the
              Python F4S gateway on 10.1.6.17:502; this GVL is the clean
              boundary between the driver and the application logic.
              Matches the Project Development Package spec and the build
              guide already in codesys-python-tcp-integration/python-gateway/README.md
              (CODESYS Integration section).

    ------------------------------------------------------------------
    CODESYS Modbus TCP Master Configuration (to be set in IDE):
        Network adapter : [your LAN, reach to gateway IP]
        IP address      : 10.1.6.17
        Port            : 502
        Slave ID        : 1
        Cycle time      : 100 ms (or desired cyclic read interval)
    ------------------------------------------------------------------
    TCP Channel configuration (5 holding registers, all x10 scaled):
      Reg 2: ReadTemp            FC03 (read)   -> wInput1Value (chamber temp)
      Reg 3: ReadSetpoint        FC03 (read)   -> wSetpoint1Read (confirmed SP)
      Reg 4: ReadStatus          FC03 (read)   -> wStatus (0=OK, 2=WRITE_FAILED, etc.)
      Reg 0: WriteSetpoint       FC06 (write)  -> wSetpoint1Write (requested SP)
      Reg 1: WriteTrigger        FC06 (write)  -> xWriteTrigger (apply pulse)

    Values carry one implied decimal place: raw 1300 == 130.0 degC.

    SIGNEDNESS: these are declared WORD because that is what the Modbus
    channels deliver, but the values are SIGNED 16-bit two's complement.
    -1.0 degC arrives as 16#FFF6 (65526). PLC_PRG must therefore convert with
    WORD_TO_INT on every read and INT_TO_WORD(REAL_TO_INT(..)) on every write.
    Dividing these WORDs directly is what made the entire sub-zero half of the
    -40..200 degC range unreachable -- see
    codesys-python-gateway-modbus/docs/RANGE_INVESTIGATION.md.
    Register 1 (trigger) is edge-triggered only (RISING_EDGE in I/O Mapping)
    so a write pulse fires the request once.

    See Gateway README for register semantics and fault codes.
*)
{attribute 'qualified_only'}
VAR_GLOBAL
    (* Reg 2: FC03 cyclic read -> actual chamber temperature raw (x10) *)
    wInput1Value    : WORD;

    (* Reg 3: FC03 cyclic read -> confirmed setpoint read-back raw (x10) *)
    wSetpoint1Read  : WORD;

    (* Reg 4: FC03 cyclic read -> gateway status code
       0=OK, 2=WRITE_FAILED, 3=NOT_ACCEPTED, 4=RANGE, 5=COMMS *)
    wStatus         : WORD;

    (* Reg 0: FC06 write -> requested setpoint raw (x10) *)
    wSetpoint1Write : WORD;

    (* Constant 1 sent to reg 1 by the rising-edge trigger channel.
       Map this to the Holding Registers[1] DATA WORD row (%QW3). A CODESYS
       rising-edge FC06 channel sends the current value of its mapped data
       word when the trigger bit goes 0->1; leaving that row unmapped sends 0,
       and the gateway only fires on 1 -- so writes would appear to succeed
       and do nothing at all. *)
    wTriggerValue   : WORD := 1;

    (* Reg 1: FC06 write (RISING_EDGE only) -> apply trigger pulse (0/1).
       Map this to the Holding Registers[1] TRIGGER BIT row (%QX4.0). *)
    xWriteTrigger   : BOOL;

    (* Master/slave diagnostic bits from the device IEC objects *)
    xModbusError    : BOOL;   (* Modbus master error flag *)
    xModbusDone     : BOOL;   (* last transaction completed *)
END_VAR
