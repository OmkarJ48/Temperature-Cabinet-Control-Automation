(*
    GVL:      GVL_HMI
    Project:  Temperature Cabinet Setpoint Control from CODESYS HMI
    Author:   OJ (Omkar Joshi) - Oliver Mechatronics
    Purpose:  Every tag the WebVisu screen binds to. Keeping the HMI
              interface in one GVL makes the Visualization wiring obvious
              and keeps the control logic (FB_CabinetSetpointControl) free
              of screen concerns.
              Matches the Project Development Package spec (WebVisu design
              spec, section B) already reflected in this repo's READMEs.

    WebVisu layout (design guidance handed to the Visualization editor):
      - Oliver Mechatronics logo, top of screen.
      - Gear button labelled "Set the cabinet temperature setpoint".
        The gear opens a pop-up dialog (dlgSetpoint) that binds:
            rReqSetpoint   -> numeric entry (degC), Min 30.0 / Max 130.0
            xSetBtn        -> "SET" momentary button
            xResetBtn      -> "RESET" momentary button
      - Chamber Temperature tile   -> rChamberTemp (read-back, live)
      - Confirmed setpoint tile     -> rConfirmedSetpoint
      - Status banner               -> sStatusText, colour driven by
                                        xFaultActive / xSetpointConfirmed
*)
{attribute 'qualified_only'}
VAR_GLOBAL
    (* ---- Displayed feedback (logic -> WebVisu) ---- *)
    rChamberTemp        : REAL;           (* actual temp, deg C (read/10)    *)
    rConfirmedSetpoint  : REAL;           (* last confirmed SP, deg C        *)

    (* ---- Operator inputs (WebVisu -> logic) ---- *)
    rReqSetpoint        : REAL := 75.0;   (* operator entry (dialog), degC   *)
    xSetBtn              : BOOL;           (* dialog SET button               *)
    xResetBtn            : BOOL;           (* dialog/banner RESET button      *)

    (* ---- Status feedback (logic -> WebVisu) ---- *)
    xSetpointConfirmed   : BOOL;           (* green banner driver             *)
    xFaultActive         : BOOL;           (* red banner driver               *)
    eFaultCode            : E_FaultCode;
    sStatusText           : STRING(80);

    (* ---- Scheduled ramp gate (logic -> hardware -> WebVisu feedback) ----
       README cabinet-on-off-automation §17 (as-built): EL2869 CH15/CH16 drive the
       F4S's own digital inputs 1/2 directly. The §15 Option C route into the button
       station was attempted and abandoned -- the station is low-side (ground)
       switching and the EL2869 is a sourcing output, so the two cannot interface
       directly at any terminal arrangement (§17.3 topology note). The F4S digital
       inputs are opto-isolated and expect a sourced 24 V signal: a matched pairing. *)
    xSchedEnable         : BOOL;           (* scheduler enabled flag          *)
    dtSchedStart         : DT;             (* scheduled start date/time (local, wall-clock) *)

    (* The Pi's hardware RTC is kept in UTC (Linux standard practice, confirmed
       via timedatectl: "RTC in local TZ: no"). SysTimeRtcHighResGet reads that
       UTC clock directly with no DST conversion, so dtNow would sit 0-1h behind
       the local wall clock the operator reads dtSchedStart against. This offset
       corrects it. UK has no automatic DST library call available here, so this
       must be toggled by hand twice a year:
         3600 = BST (British Summer Time, late Mar - late Oct)
         0    = GMT (winter, late Oct - late Mar) *)
    diUtcOffsetSec       : DINT := 3600;

    xCabinetOnCmd        : BOOL;           (* desired state, derived from schedule *)
    xRampInhibit         : BOOL;           (* -> EL2869 CH15 -> F4 terminal 28 (D/I 1, "Control Outputs Off") *)
    xRampActive          : BOOL;           (* feedback: inverted from xRampInhibit *)
    xAllOutputsOff       : BOOL;           (* -> EL2869 CH16 -> F4 terminal 29 (D/I 2). MUST stay FALSE
                                              in normal operation -- active causes a silent cooling
                                              lockout, README §17.5/§17.7. Mapped for future use only. *)
    tOffLockRemain        : TIME;           (* anti-short-cycle: time left before gate release is allowed *)
    tOffLockDuration      : TIME := T#10S;  (* compressor min off-time, adjustable from watch window for testing *)
END_VAR
